#!/bin/sh
# GhostCat OS — évite de réécrire les bases dconf du système quand rien n'a changé.
# developed by 0x3 · https://t.me/data0x3
#
# Pendant une mise à jour, pacman réinstalle les fichiers de /etc/dconf/db/*.d même
# identiques, puis le hook de dconf lance « dconf update », qui réécrit la base.
# Chaque session ouverte reçoit alors un « tout a changé » et GNOME Shell peut planter
# (horloge de gnome-desktop libérée pendant une notification en attente).
#
# On garde l'empreinte des fichiers dont chaque base est construite. Ce hook passe avant
# celui de dconf : si l'empreinte n'a pas bougé, le dossier est daté juste avant la base
# et « dconf update » la laisse telle quelle. Sinon la base est reconstruite, normalement.
#
#   dconf-keep                  hook (avant « dconf update »)
#   dconf-keep --record         la base vient d'être construite : noter l'empreinte
#   dconf-keep --record-missing noter l'empreinte là où elle manque (mise à niveau)
STATE=/var/lib/ghostcat/dconf
mode="${1:-}"
mkdir -p "$STATE"
for d in /etc/dconf/db/*.d; do
  [ -d "$d" ] || continue
  name="$(basename "$d" .d)"
  db="/etc/dconf/db/$name"
  sum="$(cd "$d" && find . -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum | cut -d' ' -f1)"
  case $mode in
    --record) echo "$sum" > "$STATE/$name.sum" ;;
    --record-missing) [ -f "$STATE/$name.sum" ] || echo "$sum" > "$STATE/$name.sum" ;;
    *)
      if [ -f "$db" ] && [ "$(cat "$STATE/$name.sum" 2>/dev/null)" = "$sum" ]; then
        t=$(( $(stat -c %Y "$db") - 1 ))
        find "$d" -exec touch -h -d "@$t" {} + 2>/dev/null
        echo "  base $name inchangée"
      else
        echo "$sum" > "$STATE/$name.sum"     # le hook de dconf la reconstruit juste après
      fi ;;
  esac
done
exit 0
