_apply() {
  if command -v plymouth-set-default-theme >/dev/null; then
    [ -f /etc/plymouth/plymouthd.conf ] || printf '[Daemon]\nTheme=ghostcat\nShowDelay=0\n' > /etc/plymouth/plymouthd.conf
    plymouth-set-default-theme ghostcat 2>/dev/null || true
  fi
}
# « dconf update » seulement à la première installation : lors des mises à jour, c'est le
# hook dconf-update.hook de GhostCat qui décide (pas de réécriture si rien n'a changé)
post_install() { dconf update 2>/dev/null || true; /usr/lib/ghostcat/dconf-update --record; _apply; }
post_upgrade() { /usr/lib/ghostcat/dconf-update --record-missing; _apply; }
