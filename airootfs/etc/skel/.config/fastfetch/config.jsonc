{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/ghostcat.txt",
    "type": "file",
    "color": { "1": "white" },
    "padding": { "top": 1, "left": 2 }
  },
  "display": {
    "separator": " ▸ ",
    "color": "white"
  },
  "modules": [
    { "type": "custom", "format": "\u001b[1;37m  GhostCat OS — Cybersecurity Edition\u001b[0m" },
    { "type": "custom", "format": "\u001b[90m  developed by 0x3 · https://t.me/data0x3\u001b[0m" },
    "break",
    { "type": "title", "key": "  user" },
    { "type": "os", "key": "  os  " },
    { "type": "kernel", "key": "  krnl" },
    { "type": "uptime", "key": "  up  " },
    { "type": "packages", "key": "  pkgs" },
    { "type": "de", "key": "  de  " },
    { "type": "terminal", "key": "  term" },
    { "type": "cpu", "key": "  cpu " },
    { "type": "memory", "key": "  mem " },
    "break"
  ]
}
