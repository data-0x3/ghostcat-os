# GhostCat OS — réglages GNOME par défaut — developed by 0x3
[org/gnome/desktop/interface]
color-scheme='prefer-dark'
gtk-theme='adw-gtk3-dark'
icon-theme='GhostCat'
accent-color='slate'
cursor-size=24
monospace-font-name='JetBrainsMono Nerd Font 11'
clock-show-seconds=true
enable-hot-corners=false
enable-animations=true

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/ghostcat/ghostcat-dark.png'
picture-uri-dark='file:///usr/share/backgrounds/ghostcat/ghostcat-dark.png'
picture-options='zoom'
primary-color='#000000'

[org/gnome/desktop/screensaver]
lock-enabled=true
lock-delay=uint32 0
picture-uri='file:///usr/share/backgrounds/ghostcat/ghostcat-dark.png'
primary-color='#000000'

[org/gnome/desktop/wm/preferences]
button-layout='appmenu:minimize,maximize,close'

[org/gnome/shell]
favorite-apps=['ghostcat-hub.desktop','org.gnome.Console.desktop','firefox.desktop','org.gnome.Nautilus.desktop','code-oss.desktop','org.wireshark.Wireshark.desktop']
enabled-extensions=['user-theme@gnome-shell-extensions.gcampax.github.com','blur-my-shell@aunetx','dash-to-dock@micxgx.gmail.com','burn-my-windows@schneegans.github.com']
disable-user-extensions=false
# l'assistant GhostCat Setup remplace la visite de bienvenue de GNOME
welcome-dialog-last-shown-version='999'

# --- effet verre : flou derrière le panneau, la vue d'ensemble et le dock
# --- thème GNOME Shell GhostCat (barre, menus, grille d'applis, dock)
[org/gnome/shell/extensions/user-theme]
name='GhostCat'

[org/gnome/shell/extensions/blur-my-shell/panel]
blur=true

[org/gnome/shell/extensions/blur-my-shell/overview]
blur=true

[org/gnome/shell/extensions/blur-my-shell/dash-to-dock]
blur=true

[org/gnome/shell/extensions/blur-my-shell/appfolder]
blur=true

# --- dock flottant translucide
[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
dock-fixed=false
intellihide=true
extend-height=false
custom-theme-shrink=true
dash-max-icon-size=44
transparency-mode='FIXED'
background-opacity=0.15
running-indicator-style='DOTS'
show-trash=false
click-action='minimize-or-previews'
apply-custom-theme=false
show-apps-icon-file='/usr/share/themes/GhostCat/gnome-shell/assets/ghost-apps.png'
show-apps-at-top=true
animation-time=0.25
hot-keys=false

[org/gnome/Console]
theme='night'

# --- vie privée ---
[org/gnome/system/location]
enabled=false

[org/gnome/desktop/privacy]
remember-recent-files=false
recent-files-max-age=1
remove-old-temp-files=true
remove-old-trash-files=true
old-files-age=uint32 7
report-technical-problems=false
send-software-usage-stats=false
remember-app-usage=false
hide-identity=true
show-full-name-in-top-bar=false

[org/gnome/desktop/search-providers]
disable-external=true

[org/gnome/desktop/notifications]
show-in-lock-screen=false

[org/gnome/desktop/session]
idle-delay=uint32 300

[org/gnome/online-accounts]
whitelisted-providers=['']

[org/gnome/software]
allow-updates=false
download-updates=false

# --- terminal GhostCat (noir profond, texte blanc, palette en nuances de gris + touches de couleur)
[org/gnome/terminal/legacy/profiles:]
default='b1dcc9dd-5262-4d8d-a863-c897e6d979b9'
list=['b1dcc9dd-5262-4d8d-a863-c897e6d979b9']

[org/gnome/terminal/legacy/profiles:/:b1dcc9dd-5262-4d8d-a863-c897e6d979b9]
visible-name='GhostCat'
use-theme-colors=false
background-color='#08080b'
foreground-color='#e8e8f0'
bold-color-same-as-fg=true
cursor-colors-set=true
cursor-background-color='#ffffff'
cursor-foreground-color='#08080b'
cursor-shape='ibeam'
cursor-blink-mode='on'
highlight-colors-set=true
highlight-background-color='#e8e8f0'
highlight-foreground-color='#08080b'
palette=['#16161c', '#ff4d6d', '#3ddc97', '#ffd76b', '#4d8dff', '#b26bff', '#5ad4e6', '#c8c8d2', '#4a4a56', '#ff7a90', '#6ff0b5', '#ffe49a', '#7aa9ff', '#c995ff', '#8ae6f2', '#ffffff']
use-system-font=false
font='JetBrainsMono Nerd Font 11'
use-transparent-background=true
background-transparency-percent=8
scrollbar-policy='never'
audible-bell=false
default-size-columns=110
default-size-rows=30

[org/gnome/terminal/legacy]
theme-variant='dark'
default-show-menubar=false
headerbar=@mb true

# --- grille d'applis : dossiers GhostCat (les lanceurs d'outils portent ces catégories)
[org/gnome/desktop/app-folders]
folder-children=['GhostCat-Red', 'GhostCat-Blue', 'GhostCat-Purple', 'GhostCat-System', 'Utilities', 'Office', 'Media', 'System']

[org/gnome/desktop/app-folders/folders/GhostCat-Red]
name='Red Team'
categories=['X-GhostCat-Red']
translate=false

[org/gnome/desktop/app-folders/folders/GhostCat-Blue]
name='Blue Team'
categories=['X-GhostCat-Blue']
translate=false

[org/gnome/desktop/app-folders/folders/GhostCat-Purple]
name='Purple Team'
categories=['X-GhostCat-Purple']
translate=false

[org/gnome/desktop/app-folders/folders/GhostCat-System]
name='GhostCat'
categories=['X-GhostCat-System']
translate=false

[org/gnome/desktop/app-folders/folders/Utilities]
name='Utilities'
categories=['Utility', 'X-GNOME-Utilities']
excluded-apps=['ghostcat-hub.desktop', 'ghostcat-setup.desktop']
translate=false

[org/gnome/desktop/app-folders/folders/Office]
name='Office'
categories=['Office']
translate=false

[org/gnome/desktop/app-folders/folders/Media]
name='Media'
categories=['AudioVideo', 'Audio', 'Video', 'Graphics']
translate=false

[org/gnome/desktop/app-folders/folders/System]
name='System'
categories=['System', 'Settings', 'Monitor']
excluded-apps=['ghostcat-hub.desktop', 'ghostcat-setup.desktop', 'org.gnome.Settings.desktop']
translate=false
