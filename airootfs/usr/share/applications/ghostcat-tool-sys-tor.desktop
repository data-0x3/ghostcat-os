[Desktop Entry]
Type=Application
Name=Start Tor
Name[fr]=Démarrer Tor
Comment=Starts the Tor service and proxychains to anonymize a tool.
Comment[fr]=Lance le service Tor et proxychains pour anonymiser un outil.
Exec=/usr/local/bin/ghostcat-hub --run=sys-tor
Icon=ghostcat-tool-sys-tor
Terminal=false
StartupNotify=false
Categories=X-GhostCat-System;
Keywords=Système;system;cyber;security;
