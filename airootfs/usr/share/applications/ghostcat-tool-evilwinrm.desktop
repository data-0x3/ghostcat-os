[Desktop Entry]
Type=Application
Name=Evil-WinRM
Name[fr]=Evil-WinRM
Comment=WinRM shell for Windows administration and post-exploitation.
Comment[fr]=Shell WinRM pour l'administration et le post-exploitation Windows.
Exec=/usr/local/bin/ghostcat-hub --run=evilwinrm
Icon=ghostcat-tool-evilwinrm
Terminal=false
StartupNotify=false
Categories=X-GhostCat-Red;
Keywords=Active Directory;red;cyber;security;
