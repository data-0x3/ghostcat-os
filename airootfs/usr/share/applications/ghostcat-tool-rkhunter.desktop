[Desktop Entry]
Type=Application
Name=rkhunter
Name[fr]=rkhunter
Comment=Hunts for rootkits and modified system files.
Comment[fr]=Recherche de rootkits et de fichiers système modifiés.
Exec=/usr/local/bin/ghostcat-hub --run=rkhunter
Icon=ghostcat-tool-rkhunter
Terminal=false
StartupNotify=false
Categories=X-GhostCat-Blue;
Keywords=Malware;blue;cyber;security;
