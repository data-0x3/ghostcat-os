[Desktop Entry]
Type=Application
Name=Turn on the firewall
Name[fr]=Activer le pare-feu
Comment=Turns on UFW and blocks incoming connections.
Comment[fr]=Active UFW en bloquant les connexions entrantes.
Exec=/usr/local/bin/ghostcat-hub --run=sys-fw
Icon=ghostcat-tool-sys-fw
Terminal=false
StartupNotify=false
Categories=X-GhostCat-System;
Keywords=Système;system;cyber;security;
