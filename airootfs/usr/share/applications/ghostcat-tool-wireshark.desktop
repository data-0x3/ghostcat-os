[Desktop Entry]
Type=Application
Name=Wireshark
Name[fr]=Wireshark
Comment=Graphical network traffic analysis, packet by packet.
Comment[fr]=Analyse graphique du trafic réseau, paquet par paquet.
Exec=/usr/local/bin/ghostcat-hub --run=wireshark
Icon=ghostcat-tool-wireshark
Terminal=false
StartupNotify=false
Categories=X-GhostCat-Blue;
Keywords=Surveillance réseau;blue;cyber;security;
